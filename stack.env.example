# The production stack (compose.yaml). Set these in the Portainer stack's "Environment variables", or copy
# this file to a git-ignored .env next to compose.yaml when running it by hand. Every value is a
# placeholder; the server refuses to start with the secret placeholders. .env.example is for local runs.

# PostgreSQL's password; the stack builds DATABASE_URL from it. Letters, digits, '-' and '_' only, since it
# sits in a URL: openssl rand -hex 24. PostgreSQL takes it only when the db volume is first created;
# changing it later means ALTER USER inside the database as well.
DB_PASSWORD=replace-with-a-database-password

# At least 32 random characters: openssl rand -base64 32 | tr -d '\n=' | tr '+/' '-_'
APP_SECRET=replace-with-at-least-32-random-characters

# Any SMTP relay, for sign-in codes and invitations. A Gmail app password, for example:
# smtps://you%40gmail.com:app-password@smtp.gmail.com:465
SMTP_URL=smtps://user:password@smtp.example.test:465
MAIL_FROM=Bible Study <no-reply@example.test>

# The HTTPS address members open; used in email links and invitation links.
PUBLIC_URL=https://bible.example.test

# The group owner's email. The first sign-in with it creates the group.
OWNER_EMAIL=owner@example.test

# The study assistant: the one address allowed to use it, and the token its connector presents (at least
# 32 random characters). Leave both unset to turn the assistant off.
# ASSISTANT_OWNER_EMAIL=owner@example.test
# CONNECTOR_TOKEN=replace-with-at-least-32-random-characters

# CSB from API.Bible (free Starter plan). Leave unset to keep CSB off.
# APIBIBLE_KEY=replace-with-your-api-bible-key
# APIBIBLE_CSB_BIBLE_ID=replace-with-the-csb-bible-id

# A commit tag (ghcr.io/the-running-dev/subzerodev.biblestudy:<sha>) pins a rollback; unset is :latest.
# BIBLESTUDY_IMAGE=ghcr.io/the-running-dev/subzerodev.biblestudy:latest
# The reverse proxy's existing Docker network.
# PROXY_NETWORK=proxy-net
# Nightly backups: time of day in UTC, runs kept, and where (a volume name, or a host path owned by uid 1000).
# BACKUP_AT=03:30
# BACKUP_KEEP=14
# BACKUP_DIR=/srv/backups/biblestudy

# The stack defaults these to production values (secure cookies, one proxy hop); change them only when the
# deployment differs. See .env.example for what each means.
# COOKIE_SECURE=true
# TRUST_PROXY=1
# AOLAB_BASE_URL=https://bible.helloao.org

# Imported CSB: owner (default, verified OWNER_EMAIL only), or disabled (nobody). No group sharing.
CSB_IMPORTED_ACCESS=owner
