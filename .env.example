# Copy to .env for local runs. Every value here is a placeholder; never commit real ones.

# PostgreSQL 17. The dev value matches compose.dev.yaml.
DATABASE_URL=postgres://biblestudy:biblestudy@localhost:55432/biblestudy

# At least 32 random characters. Login-code hashes and sealed email secrets derive from it,
# so changing it invalidates outstanding codes (sessions survive).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=replace-with-at-least-32-random-characters

# Any SMTP relay. Development uses Mailpit from compose.dev.yaml.
# Production with a Gmail app password: smtps://you%40gmail.com:app-password@smtp.gmail.com:465
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Bible Study <no-reply@example.test>

# The address members open; used in email links and invitation links.
PUBLIC_URL=http://localhost:3000

# The group owner's email. The first sign-in with it creates the group (Monday 06:15 America/Chicago,
# starting at Romans 1). Until it is set, nobody can create invitations.
OWNER_EMAIL=owner@example.test

PORT=3000
# Set to false only for plain-http local runs; production is behind HTTPS.
COOKIE_SECURE=false
# Behind a reverse proxy, the number of proxy hops in front of the app (usually 1), or the proxy's
# addresses (comma-separated IPs or CIDRs), so rate limits see the client address. "true" is refused:
# trusting every hop lets a client forge X-Forwarded-For. Leave false when nothing sits in front.
TRUST_PROXY=false
# The AO Lab Free Use Bible API needs no key. import-content reads it, and the server fetches
# narration from it on first request.
# AOLAB_BASE_URL=https://bible.helloao.org

# Where recordings are stored, one file per SHA-256. A persistent volume in production.
MEDIA_DIR=data/media

# Stamped by the container build; served at /__build-id.
BUILD_ID=dev

# The study assistant (Skynet on the owner's PC). Only this address may use it; unset, nobody can.
ASSISTANT_OWNER_EMAIL=owner@example.test
# Shared by the server and the connector; at least 32 random characters. Unset, /connector refuses every link.
CONNECTOR_TOKEN=replace-with-at-least-32-random-characters

# Read by the connector only (npm run connector, on the PC that runs AgentConsole): the server it
# links to, the AgentConsole runtime entry point, where it keeps its state, and the runtime provider.
CONNECTOR_SERVER_URL=http://localhost:3000
AGENTCONSOLE_RUNTIME=C:/path/to/agent-console/runtime/main.js
# CONNECTOR_STATE_DIR=data/connector
# AGENTCONSOLE_PROVIDER=claude

# The production stack (compose.yaml) only. It builds DATABASE_URL from this password, so DATABASE_URL
# above is not used there. At least 24 random characters.
DB_PASSWORD=replace-with-a-database-password
# A commit tag (ghcr.io/the-running-dev/subzerodev.biblestudy:<sha>) pins a rollback; unset is :latest.
# BIBLESTUDY_IMAGE=ghcr.io/the-running-dev/subzerodev.biblestudy:latest
# The reverse proxy's existing Docker network.
# PROXY_NETWORK=proxy-net
# Nightly backups: time of day in UTC, runs kept, and where (a volume name, or a host path owned by uid 1000).
# BACKUP_AT=03:30
# BACKUP_KEEP=14
# BACKUP_DIR=/srv/backups/biblestudy
