# Copy to .env for local runs. Every value here is a placeholder; never commit real ones.

# PostgreSQL 17. The dev value matches compose.dev.yaml.
DATABASE_URL=postgres://biblestudy:biblestudy@localhost:55432/biblestudy

# At least 32 random characters. Login-code hashes and sealed email secrets derive from it,
# so changing it invalidates outstanding codes (sessions survive).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=replace-with-at-least-32-random-characters

# Any SMTP relay. Development uses Mailpit from compose.dev.yaml.
# Production with a Gmail app password: smtps://you%40gmail.com:app-password@smtp.gmail.com:465
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Bible Study <no-reply@example.test>

# The address members open; used in email links.
PUBLIC_URL=http://localhost:3000

PORT=3000
# Set to false only for plain-http local runs; production is behind HTTPS.
COOKIE_SECURE=false
# Behind a reverse proxy, the number of proxy hops in front of the app (usually 1), or the proxy's
# addresses (comma-separated IPs or CIDRs), so rate limits see the client address. "true" is refused:
# trusting every hop lets a client forge X-Forwarded-For. Leave false when nothing sits in front.
TRUST_PROXY=false
# Only import-content reads this. The AO Lab Free Use Bible API needs no key.
# AOLAB_BASE_URL=https://bible.helloao.org

# Stamped by the container build; served at /__build-id.
BUILD_ID=dev
