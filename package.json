{
  "name": "subzerodev-biblestudy",
  "version": "0.1.0",
  "description": "SubZeroDev.BibleStudy",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "test": "node --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/**/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.test.ts\"",
    "lint": "eslint . --max-warnings 0",
    "start": "node src/server/web/main.ts",
    "migrate": "node src/server/platform/migrate-cli.ts",
    "import-content": "node src/server/content/import-cli.ts",
    "connector": "node src/connector/main.ts",
    "dev": "node --watch src/server/web/main.ts",
    "dev:client": "vite",
    "dev:services": "docker compose -f compose.dev.yaml up -d"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "playwright": "^1.64.1",
    "prettier": "^3.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  }
}
